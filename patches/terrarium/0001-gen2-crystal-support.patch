+-- The map is filled through the same folded projection as the scene, and
+-- LOVE 12's Metal backend stores that the other way up from OpenGL -- so
+-- the READ side has to know which way the rows run.  +1 = OpenGL (the fold
+-- lands clip +Y at the last row), -1 = Metal; nil until probed, the way
+-- Battle Art's ShadowMap does it: draw one quad through the sun shader
+-- into a 4x4 canvas and look at which end it landed on.
+local Device = V.require("Device")
+local vSign = nil
+local function toUnit(sign)
+  return { 0.5, 0, 0, 0.5,
+           0, 0.5 * sign, 0, 0.5,
+           0, 0, 0.5, 0.5,
+           0, 0, 0, 1 }
