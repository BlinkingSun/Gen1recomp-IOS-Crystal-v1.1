 -- Begin the sun pass. Returns false when it could not start, in which case
 -- the caller must not draw into it or call finish.
+-- Which way this runtime stores a pass drawn through the folded projection.
+-- Fill a tiny canvas through the sun shader with a strip that covers only
+-- the +Y half of clip space (which the fold sends to the -Y half), then read
+-- back which end of the canvas it landed on.  OpenGL reads it back at the
+-- first rows (+1, the orientation the uv mapping was written for); Metal at
+-- the last rows (-1).  An unreadable or ambiguous answer falls back to the
+-- renderer name.
+local function probeVSign()
+  local ok, sign = pcall(function()
+    local sh, tex = getShader(), getBlank()
+    if not (sh and tex) then return nil end
+    local size = 8
+    local c = love.graphics.newCanvas(size, size, { dpiscale = 1 })
+    -- a strip from y = 0.2 to y = 1 in clip space, full width; the fold in
+    -- lightVP below is the same one fit() applies to the real map
+    local strip = love.graphics.newMesh(
+      { { -1, 0.2, 0, 0 }, { 1, 0.2, 1, 0 }, { 1, 1, 1, 1 }, { -1, 1, 0, 1 } },
+      "fan", "static")
+    strip:setTexture(tex)
+    love.graphics.push("all")
+    love.graphics.setCanvas(c)
+    love.graphics.clear(1, 1, 1, 1)
+    love.graphics.setShader(sh)
+    love.graphics.setColor(1, 1, 1, 1)
+    pcall(sh.send, sh, "lightVP", "row", Mat4.scale(1, -1, 1))
+    pcall(sh.send, sh, "model", "row", IDENTITY)
+    love.graphics.draw(strip)
+    love.graphics.pop()
+    local px = c:newImageData()
+    local function touched(row)
+      local r, g, b = px:getPixel(math.floor(size / 2), row)
+      return (r + g + b) < 2.7      -- anything the shader wrote is not the clear
+    end
+    local first, last = touched(0), touched(size - 1)
+    if first ~= last then return first and 1 or -1 end
+    return nil
+  end)
+  if ok and (sign == 1 or sign == -1) then return sign end
+  return Device.metal() and -1 or 1
+end
+
 function ShadowMap.begin(cx, cy, vw, vh)
   local sh = getShader()
   if not sh then return false end
+  -- the runtime's storage orientation, measured once before the first fit
+  if vSign == nil then
+    vSign = probeVSign()
+    ShadowMap.vSign = vSign
+  end
   -- fit first: it is what decides which resolution rung this view wants
   fit(cx, cy, vw, vh)
   local c = getCanvas(ShadowMap.res)
