diff --git a/lib/Device.lua b/lib/Device.lua
index 0b3a2c3..a3ed1ba 100644
--- a/lib/Device.lua
+++ b/lib/Device.lua
@@ -124,4 +124,34 @@ function Device.invalidate()
   info, isMobile = nil, nil
 end
 
+-- LOVE 12's Metal backend (iOS, macOS): custom clip-space output lands in
+-- a canvas the OTHER way up from OpenGL, so every place this mod bypasses
+-- transform_projection asks here before flipping clip Y.  A renderer string
+-- mentioning Metal is not enough on its own -- LOVE 11 keeps the OpenGL
+-- canvas convention -- so the major version gates it (Battle Art's rule).
+local metal = nil
+function Device.metal()
+  if metal ~= nil then return metal end
+  metal = false
+  if not (love and love.getVersion and love.graphics
+          and love.graphics.getRendererInfo) then return false end
+  local okV, major = pcall(love.getVersion)
+  if not okV or type(major) ~= "number" or major < 12 then return false end
+  local ok, name, version, vendor, dev = pcall(love.graphics.getRendererInfo)
+  if not ok then return false end
+  local api = tostring(name):lower()
+  -- Apple's desktop OpenGL driver calls itself "OpenGL 4.1 Metal - ...": an
+  -- OpenGL renderer is OpenGL whatever its version string mentions.  Only
+  -- OpenGL ES on an Apple device is LOVE's Metal compatibility path.
+  if api:find("opengl", 1, true) and not api:find("opengl es", 1, true) then
+    metal = false
+    return false
+  end
+  local info = table.concat({ api, tostring(version), tostring(vendor),
+                              tostring(dev) }, " "):lower()
+  metal = api:find("metal", 1, true) ~= nil
+       or (info:find("apple", 1, true) ~= nil and api:find("opengl es", 1, true) ~= nil)
+  return metal
+end
+
 return Device
